# Publish add-on source, reproducible packagers, and compact documentation.
# Local game assets and experiment outputs stay outside Git.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/addons/
/addons/*
!/addons/random_play_toon/
!/addons/random_play_copy/
!/python_scripts/
/python_scripts/*
!/python_scripts/animation/
/python_scripts/animation/*
!/python_scripts/animation/build/
/python_scripts/animation/build/*
!/python_scripts/animation/build/sync_copy_style_panel.py
!/python_scripts/animation/release/
/python_scripts/animation/release/*
!/python_scripts/animation/release/package_copy.py
!/python_scripts/generalization/
/python_scripts/generalization/*
!/python_scripts/generalization/release/
/python_scripts/generalization/release/*
!/python_scripts/generalization/release/package_release.py
!/docs/
/docs/*
!/docs/*.md
!/docs/images/
/docs/images/*
!/docs/images/toon-characters.jpg
!/docs/images/toon-panel.png
!/docs/images/copy-panel.png
!/docs/images/style-global.png
!/docs/images/style-hair.png

__pycache__/
*.py[cod]
.pytest_cache/
*.blend1
*.log
*.tmp
